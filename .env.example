# AgriCopilot AI configuration
# 1. Copy this file to .env:
#    Windows: copy .env.example .env
#    macOS/Linux: cp .env.example .env
# 2. Create an OpenRouter API key at https://openrouter.ai/keys
# 3. Paste the key below. Never commit your real .env file.

OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional: preferred model to try before the built-in fallback list.
# If this model returns 404, AgriCopilot automatically tries free fallback models.
OPENROUTER_MODEL=openrouter/free

# Express server port
PORT=3000
